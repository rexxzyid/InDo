impor { tokenisasi } dari "./lexer.wni"
impor { uraiAngka, uraiBilanganBesar, uraiTeks, irisTemplate, masakTemplate } dari "./literal.wni"

tetap BP_BINER = baru Peta()
BP_BINER.tetapkan("Nullish", 1)
BP_BINER.tetapkan("AtauAtau", 2)
BP_BINER.tetapkan("DanDan", 3)
BP_BINER.tetapkan("Atau", 4)
BP_BINER.tetapkan("Xor", 5)
BP_BINER.tetapkan("Dan", 6)
BP_BINER.tetapkan("SamaSama", 7)
BP_BINER.tetapkan("TidakSama", 7)
BP_BINER.tetapkan("SamaSamaSama", 7)
BP_BINER.tetapkan("TidakSamaSama", 7)
BP_BINER.tetapkan("KurangDari", 8)
BP_BINER.tetapkan("LebihDari", 8)
BP_BINER.tetapkan("KurangSamaDari", 8)
BP_BINER.tetapkan("LebihSamaDari", 8)
