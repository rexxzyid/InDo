TEKS_OPERATOR.tetapkan("Kurang", "-")
TEKS_OPERATOR.tetapkan("Kali", "*")
TEKS_OPERATOR.tetapkan("Bagi", "/")
TEKS_OPERATOR.tetapkan("Sisa", "%")
TEKS_OPERATOR.tetapkan("Pangkat", "**")
TEKS_OPERATOR.tetapkan("Dan", "&")
TEKS_OPERATOR.tetapkan("Atau", "|")
TEKS_OPERATOR.tetapkan("Xor", "^")
TEKS_OPERATOR.tetapkan("GeserKiri", "<<")
TEKS_OPERATOR.tetapkan("GeserKanan", ">>")
TEKS_OPERATOR.tetapkan("GeserKananNol", ">>>")
TEKS_OPERATOR.tetapkan("SamaSama", "==")
TEKS_OPERATOR.tetapkan("TidakSama", "!=")
