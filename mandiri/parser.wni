OPERATOR_PENUGASAN.tetapkan("TambahSama", "+=")
OPERATOR_PENUGASAN.tetapkan("KurangSama", "-=")
OPERATOR_PENUGASAN.tetapkan("KaliSama", "*=")
OPERATOR_PENUGASAN.tetapkan("BagiSama", "/=")
OPERATOR_PENUGASAN.tetapkan("SisaSama", "%=")
OPERATOR_PENUGASAN.tetapkan("PangkatSama", "**=")
