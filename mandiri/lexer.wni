tetap HURUF_AWAL = /[A-Za-z_$À-￿]/
tetap HURUF_LANJUT = /[A-Za-z0-9_$À-￿]/
tetap DIGIT = /[0-9]/
tetap HEKSA = /[0-9a-fA-F]/
tetap BINER = /[01]/
tetap OKTAL = /[0-7]/

tetap KATA_KUNCI = baru Peta()
KATA_KUNCI.tetapkan("misal", "KkMisal")
KATA_KUNCI.tetapkan("tetap", "KkTetap")
KATA_KUNCI.tetapkan("var", "KkVar")
KATA_KUNCI.tetapkan("jika", "KkJika")
KATA_KUNCI.tetapkan("lainnya", "KkLainnya")
KATA_KUNCI.tetapkan("pilih", "KkPilih")
KATA_KUNCI.tetapkan("kasus", "KkKasus")
KATA_KUNCI.tetapkan("bawaan", "KkBawaan")
KATA_KUNCI.tetapkan("selama", "KkSelama")
KATA_KUNCI.tetapkan("lakukan", "KkLakukan")
KATA_KUNCI.tetapkan("untuk", "KkUntuk")
KATA_KUNCI.tetapkan("dari", "KkDari")
KATA_KUNCI.tetapkan("dalam", "KkDalam")
KATA_KUNCI.tetapkan("henti", "KkHenti")
KATA_KUNCI.tetapkan("lanjut", "KkLanjut")
KATA_KUNCI.tetapkan("fungsi", "KkFungsi")
KATA_KUNCI.tetapkan("kembalikan", "KkKembalikan")
KATA_KUNCI.tetapkan("hasilkan", "KkHasilkan")
KATA_KUNCI.tetapkan("asinkron", "KkAsinkron")
KATA_KUNCI.tetapkan("tunggu", "KkTunggu")
KATA_KUNCI.tetapkan("benar", "KkBenar")
KATA_KUNCI.tetapkan("salah", "KkSalah")
KATA_KUNCI.tetapkan("kosong", "KkKosong")
KATA_KUNCI.tetapkan("taktentu", "KkTaktentu")
KATA_KUNCI.tetapkan("dan", "DanDan")
KATA_KUNCI.tetapkan("atau", "AtauAtau")
KATA_KUNCI.tetapkan("bukan", "Seru")
KATA_KUNCI.tetapkan("kelas", "KkKelas")
KATA_KUNCI.tetapkan("baru", "KkBaru")
KATA_KUNCI.tetapkan("ini", "KkIni")
KATA_KUNCI.tetapkan("induk", "KkInduk")
KATA_KUNCI.tetapkan("mewarisi", "KkMewarisi")
KATA_KUNCI.tetapkan("konstruktor", "KkKonstruktor")
KATA_KUNCI.tetapkan("statis", "KkStatis")
KATA_KUNCI.tetapkan("dapatkan", "KkDapatkan")
KATA_KUNCI.tetapkan("tetapkan", "KkTetapkan")
KATA_KUNCI.tetapkan("coba", "KkCoba")
KATA_KUNCI.tetapkan("tangkap", "KkTangkap")
KATA_KUNCI.tetapkan("akhirnya", "KkAkhirnya")
KATA_KUNCI.tetapkan("lempar", "KkLempar")
KATA_KUNCI.tetapkan("impor", "KkImpor")
KATA_KUNCI.tetapkan("ekspor", "KkEkspor")
KATA_KUNCI.tetapkan("sebagai", "KkSebagai")
KATA_KUNCI.tetapkan("jenisdari", "KkJenisdari")
KATA_KUNCI.tetapkan("contohdari", "KkContohdari")
KATA_KUNCI.tetapkan("hapus", "KkHapus")
KATA_KUNCI.tetapkan("abaikan", "KkAbaikan")

tetap BISA_AKHIRI_EKSPRESI = baru Himpunan([
  "Angka",
  "BilanganBesar",
  "Teks",
  "TemplateUtuh",
  "TemplateEkor",
  "Regex",
  "Identifier",
  "PrivatNama",
  "KurungTutup",
  "SikuTutup",
  "KurawalTutup",
  "KkIni",
  "KkBenar",
  "KkSalah",
  "KkKosong",
  "KkTaktentu",
  "KkInduk",
  "TambahTambah",
  "KurangKurang",
])

kelas Lexer {
  konstruktor(sumber, namaBerkas) {
    ini.sumber = sumber
    ini.namaBerkas = namaBerkas ?? "<masukan>"
    ini.posisi = 0
    ini.baris = 1
    ini.kolom = 1
    ini.tumpukanKurawal = []
    ini.tokenTerakhir = kosong
  }

  selesai() {
    kembalikan ini.posisi >= ini.sumber.panjang
  }

  lihat(offset = 0) {
    tetap k = ini.sumber[ini.posisi + offset]
    kembalikan k ?? ""
  }

  maju() {
    tetap karakter = ini.sumber[ini.posisi] ?? ""
    ini.posisi = ini.posisi + 1
    jika (karakter == "\n") {
      ini.baris = ini.baris + 1
      ini.kolom = 1
    } lainnya {
      ini.kolom = ini.kolom + 1
    }
    kembalikan karakter
  }

  cocok(harapan) {
    jika (ini.lihat() != harapan) kembalikan salah
    ini.maju()
    kembalikan benar
  }

  galat(pesan, awal, panjang = 1) {
    tetap pos = ini.posisiDari(awal)
    tetap g = baru GalatSintaks(pesan)
    g.baris = pos.baris
    g.kolom = pos.kolom
    g.panjang = panjang
    g.namaBerkas = ini.namaBerkas
    lempar g
  }

  posisiDari(indeks) {
    misal baris = 1
    misal kolom = 1
    untuk (misal i = 0; i < indeks dan i < ini.sumber.panjang; i++) {
      jika (ini.sumber[i] == "\n") {
        baris = baris + 1
        kolom = 1
      } lainnya {
        kolom = kolom + 1
      }
    }
    kembalikan { baris: baris, kolom: kolom }
  }

  tokenisasi() {
    tetap daftar = []
    selama (benar) {
      tetap token = ini.tokenBerikut()
      daftar.tambah(token)
      jika (token.jenis == "AkhirBerkas") henti
    }
    kembalikan daftar
  }

  buat(jenis, awal, baris, kolom, bb) {
    tetap token = {
      jenis: jenis,
      teks: ini.sumber.iris(awal, ini.posisi),
      baris: baris,
      kolom: kolom,
      awal: awal,
      akhir: ini.posisi,
      didahuluiBarisBaru: bb,
    }
    ini.tokenTerakhir = token
    kembalikan token
  }

  tokenBerikut() {
    tetap bb = ini.lewatiRuangDanKomentar()
    tetap awal = ini.posisi
    tetap baris = ini.baris
    tetap kolom = ini.kolom

    jika (ini.selesai()) {
      kembalikan ini.buat("AkhirBerkas", awal, baris, kolom, bb)
    }

    tetap karakter = ini.lihat()

    jika (HURUF_AWAL.uji(karakter)) {
      kembalikan ini.bacaIdentifier(awal, baris, kolom, bb)
    }
    jika (karakter >= "0" dan karakter <= "9") {
      kembalikan ini.bacaAngka(awal, baris, kolom, bb)
    }
    jika (karakter == "." dan ini.lihat(1) >= "0" dan ini.lihat(1) <= "9") {
      kembalikan ini.bacaAngka(awal, baris, kolom, bb)
    }
    jika (karakter == "\"" atau karakter == "'") {
      kembalikan ini.bacaTeks(awal, baris, kolom, bb)
    }
    jika (karakter == "`") {
      kembalikan ini.bacaTemplateAwal(awal, baris, kolom, bb)
    }
    jika (karakter == "#") {
      kembalikan ini.bacaPrivat(awal, baris, kolom, bb)
    }
    jika (karakter == "/" dan ini.regexBolehDisini()) {
      kembalikan ini.bacaRegex(awal, baris, kolom, bb)
    }

    kembalikan ini.bacaOperator(awal, baris, kolom, bb)
  }

  lewatiRuangDanKomentar() {
    misal adaBarisBaru = salah
    selama (benar) {
      tetap karakter = ini.lihat()
      jika (karakter == "\n") {
        adaBarisBaru = benar
        ini.maju()
      } lainnya jika (karakter == " " atau karakter == "\t" atau karakter == "\r" atau karakter == "\f" atau karakter == "\v") {
        ini.maju()
      } lainnya jika (karakter == "/" dan ini.lihat(1) == "/") {
        selama (bukan ini.selesai() dan ini.lihat() != "\n") ini.maju()
      } lainnya jika (karakter == "/" dan ini.lihat(1) == "*") {
        tetap awal = ini.posisi
        ini.maju()
        ini.maju()
        selama (benar) {
          jika (ini.selesai()) ini.galat("Komentar blok tidak ditutup", awal, 2)
          jika (ini.lihat() == "\n") adaBarisBaru = benar
          jika (ini.lihat() == "*" dan ini.lihat(1) == "/") {
            ini.maju()
            ini.maju()
            henti
          }
          ini.maju()
        }
      } lainnya {
        henti
      }
    }
    kembalikan adaBarisBaru
  }

  bacaIdentifier(awal, baris, kolom, bb) {
    selama (bukan ini.selesai() dan HURUF_LANJUT.uji(ini.lihat())) ini.maju()
    tetap teks = ini.sumber.iris(awal, ini.posisi)
    tetap jenis = KATA_KUNCI.ambil(teks) ?? "Identifier"
    kembalikan ini.buat(jenis, awal, baris, kolom, bb)
  }

  bacaPrivat(awal, baris, kolom, bb) {
    ini.maju()
    jika (bukan HURUF_AWAL.uji(ini.lihat())) {
      ini.galat("Nama privat harus diikuti pengenal", awal, 1)
    }
    selama (bukan ini.selesai() dan HURUF_LANJUT.uji(ini.lihat())) ini.maju()
    kembalikan ini.buat("PrivatNama", awal, baris, kolom, bb)
  }

  bacaAngka(awal, baris, kolom, bb) {
    misal jenis = "Angka"
    jika (ini.lihat() == "0" dan (ini.lihat(1) == "x" atau ini.lihat(1) == "X")) {
      ini.maju()
      ini.maju()
      ini.bacaDigit(HEKSA, awal, salah)
      jenis = ini.mungkinBilanganBesar()
    } lainnya jika (ini.lihat() == "0" dan (ini.lihat(1) == "b" atau ini.lihat(1) == "B")) {
      ini.maju()
      ini.maju()
      ini.bacaDigit(BINER, awal, salah)
      jenis = ini.mungkinBilanganBesar()
    } lainnya jika (ini.lihat() == "0" dan (ini.lihat(1) == "o" atau ini.lihat(1) == "O")) {
      ini.maju()
      ini.maju()
      ini.bacaDigit(OKTAL, awal, salah)
      jenis = ini.mungkinBilanganBesar()
    } lainnya {
      jika (ini.lihat() != ".") ini.bacaDigit(DIGIT, awal, salah)
      misal desimalAtauEksponen = salah
      jika (ini.lihat() == ".") {
        desimalAtauEksponen = benar
        ini.maju()
        ini.bacaDigit(DIGIT, awal, benar)
      }
      jika (ini.lihat() == "e" atau ini.lihat() == "E") {
        desimalAtauEksponen = benar
        ini.maju()
        jika (ini.lihat() == "+" atau ini.lihat() == "-") ini.maju()
        jika (bukan DIGIT.uji(ini.lihat())) ini.galat("Eksponen angka tidak lengkap", awal, ini.posisi - awal)
        ini.bacaDigit(DIGIT, awal, salah)
      }
      jika (bukan desimalAtauEksponen dan ini.lihat() == "n") {
        ini.maju()
        jenis = "BilanganBesar"
      }
    }

    jika (HURUF_LANJUT.uji(ini.lihat())) {
      ini.galat("Angka diikuti karakter yang tidak valid", awal, ini.posisi - awal + 1)
    }
    kembalikan ini.buat(jenis, awal, baris, kolom, bb)
  }

  mungkinBilanganBesar() {
    jika (ini.lihat() == "n") {
      ini.maju()
      kembalikan "BilanganBesar"
    }
    kembalikan "Angka"
  }

  bacaDigit(pola, awal, bolehKosong) {
    misal jumlah = 0
    misal terakhirGarisBawah = salah
    jika (ini.lihat() == "_") ini.galat("Pemisah '_' tidak boleh di awal angka", ini.posisi, 1)
    selama (bukan ini.selesai()) {
      tetap karakter = ini.lihat()
      jika (pola.uji(karakter)) {
        jumlah = jumlah + 1
        terakhirGarisBawah = salah
        ini.maju()
      } lainnya jika (karakter == "_") {
        jika (terakhirGarisBawah) ini.galat("Pemisah '_' ganda pada angka", ini.posisi, 1)
        terakhirGarisBawah = benar
        ini.maju()
      } lainnya {
        henti
      }
    }
    jika (terakhirGarisBawah) ini.galat("Pemisah '_' tidak boleh di akhir angka", ini.posisi - 1, 1)
    jika (jumlah == 0 dan bukan bolehKosong) ini.galat("Angka tidak memiliki digit", awal, (ini.posisi - awal) atau 1)
  }

  bacaTeks(awal, baris, kolom, bb) {
    tetap pembatas = ini.maju()
    selama (benar) {
      jika (ini.selesai()) ini.galat("Teks tidak ditutup", awal, ini.posisi - awal)
      tetap karakter = ini.lihat()
      jika (karakter == "\n") ini.galat("Teks tidak boleh memuat baris baru literal", awal, ini.posisi - awal)
      jika (karakter == "\\") {
        ini.maju()
        ini.maju()
        lanjut
      }
      jika (karakter == pembatas) {
        ini.maju()
        henti
      }
      ini.maju()
    }
    kembalikan ini.buat("Teks", awal, baris, kolom, bb)
  }

  bacaTemplateAwal(awal, baris, kolom, bb) {
    ini.maju()
    kembalikan ini.lanjutkanTemplate(awal, baris, kolom, bb, benar)
  }

  lanjutkanTemplate(awal, baris, kolom, bb, kepala) {
    selama (benar) {
      jika (ini.selesai()) ini.galat("Template teks tidak ditutup", awal, ini.posisi - awal)
      tetap karakter = ini.lihat()
      jika (karakter == "\\") {
        ini.maju()
        ini.maju()
        lanjut
      }
      jika (karakter == "`") {
        ini.maju()
        kembalikan ini.buat(kepala ? "TemplateUtuh" : "TemplateEkor", awal, baris, kolom, bb)
      }
      jika (karakter == "$" dan ini.lihat(1) == "{") {
        ini.maju()
        ini.maju()
        ini.tumpukanKurawal.tambah("template")
        kembalikan ini.buat(kepala ? "TemplateKepala" : "TemplateTengah", awal, baris, kolom, bb)
      }
      ini.maju()
    }
  }

  bacaRegex(awal, baris, kolom, bb) {
    ini.maju()
    misal dalamKelas = salah
    selama (benar) {
      jika (ini.selesai()) ini.galat("Regex tidak ditutup", awal, ini.posisi - awal)
      tetap karakter = ini.lihat()
      jika (karakter == "\n") ini.galat("Regex tidak boleh memuat baris baru", awal, ini.posisi - awal)
      jika (karakter == "\\") {
        ini.maju()
        ini.maju()
        lanjut
      }
      jika (karakter == "[") {
        dalamKelas = benar
      } lainnya jika (karakter == "]") {
        dalamKelas = salah
      } lainnya jika (karakter == "/" dan bukan dalamKelas) {
        ini.maju()
        henti
      }
      ini.maju()
    }
    selama (bukan ini.selesai() dan HURUF_LANJUT.uji(ini.lihat())) ini.maju()
    kembalikan ini.buat("Regex", awal, baris, kolom, bb)
  }

  regexBolehDisini() {
    tetap t = ini.tokenTerakhir
    jika (t == kosong) kembalikan benar
    kembalikan bukan BISA_AKHIRI_EKSPRESI.punya(t.jenis)
  }

  bacaOperator(awal, baris, kolom, bb) {
    tetap karakter = ini.maju()

    jika (karakter == "(") kembalikan ini.buat("KurungBuka", awal, baris, kolom, bb)
    jika (karakter == ")") kembalikan ini.buat("KurungTutup", awal, baris, kolom, bb)
    jika (karakter == "{") {
      ini.tumpukanKurawal.tambah("biasa")
      kembalikan ini.buat("KurawalBuka", awal, baris, kolom, bb)
    }
    jika (karakter == "}") {
      tetap sifat = ini.tumpukanKurawal.hapusAkhir()
      jika (sifat == "template") {
        kembalikan ini.lanjutkanTemplate(awal, baris, kolom, bb, salah)
      }
      kembalikan ini.buat("KurawalTutup", awal, baris, kolom, bb)
    }
    jika (karakter == "[") kembalikan ini.buat("SikuBuka", awal, baris, kolom, bb)
    jika (karakter == "]") kembalikan ini.buat("SikuTutup", awal, baris, kolom, bb)
    jika (karakter == ",") kembalikan ini.buat("Koma", awal, baris, kolom, bb)
    jika (karakter == ";") kembalikan ini.buat("TitikKoma", awal, baris, kolom, bb)
    jika (karakter == ":") kembalikan ini.buat("TitikDua", awal, baris, kolom, bb)
    jika (karakter == "~") kembalikan ini.buat("Tilde", awal, baris, kolom, bb)
    jika (karakter == ".") {
      jika (ini.lihat() == "." dan ini.lihat(1) == ".") {
        ini.maju()
        ini.maju()
        kembalikan ini.buat("Elipsis", awal, baris, kolom, bb)
      }
      kembalikan ini.buat("Titik", awal, baris, kolom, bb)
    }
    jika (karakter == "?") {
      jika (ini.lihat() == "?") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("NullishSama", awal, baris, kolom, bb)
        kembalikan ini.buat("Nullish", awal, baris, kolom, bb)
      }
      jika (ini.lihat() == "." dan bukan (ini.lihat(1) >= "0" dan ini.lihat(1) <= "9")) {
        ini.maju()
        kembalikan ini.buat("TanyaTitik", awal, baris, kolom, bb)
      }
      kembalikan ini.buat("Tanya", awal, baris, kolom, bb)
    }
    jika (karakter == "+") {
      jika (ini.cocok("+")) kembalikan ini.buat("TambahTambah", awal, baris, kolom, bb)
      jika (ini.cocok("=")) kembalikan ini.buat("TambahSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Tambah", awal, baris, kolom, bb)
    }
    jika (karakter == "-") {
      jika (ini.cocok("-")) kembalikan ini.buat("KurangKurang", awal, baris, kolom, bb)
      jika (ini.cocok("=")) kembalikan ini.buat("KurangSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Kurang", awal, baris, kolom, bb)
    }
    jika (karakter == "*") {
      jika (ini.cocok("*")) {
        jika (ini.cocok("=")) kembalikan ini.buat("PangkatSama", awal, baris, kolom, bb)
        kembalikan ini.buat("Pangkat", awal, baris, kolom, bb)
      }
      jika (ini.cocok("=")) kembalikan ini.buat("KaliSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Kali", awal, baris, kolom, bb)
    }
    jika (karakter == "/") {
      jika (ini.cocok("=")) kembalikan ini.buat("BagiSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Bagi", awal, baris, kolom, bb)
    }
    jika (karakter == "%") {
      jika (ini.cocok("=")) kembalikan ini.buat("SisaSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Sisa", awal, baris, kolom, bb)
    }
    jika (karakter == "=") {
      jika (ini.lihat() == "=") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("SamaSamaSama", awal, baris, kolom, bb)
        kembalikan ini.buat("SamaSama", awal, baris, kolom, bb)
      }
      jika (ini.cocok(">")) kembalikan ini.buat("Panah", awal, baris, kolom, bb)
      kembalikan ini.buat("SamaDengan", awal, baris, kolom, bb)
    }
    jika (karakter == "!") {
      jika (ini.lihat() == "=") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("TidakSamaSama", awal, baris, kolom, bb)
        kembalikan ini.buat("TidakSama", awal, baris, kolom, bb)
      }
      kembalikan ini.buat("Seru", awal, baris, kolom, bb)
    }
    jika (karakter == "<") {
      jika (ini.lihat() == "<") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("GeserKiriSama", awal, baris, kolom, bb)
        kembalikan ini.buat("GeserKiri", awal, baris, kolom, bb)
      }
      jika (ini.cocok("=")) kembalikan ini.buat("KurangSamaDari", awal, baris, kolom, bb)
      kembalikan ini.buat("KurangDari", awal, baris, kolom, bb)
    }
    jika (karakter == ">") {
      jika (ini.lihat() == ">") {
        ini.maju()
        jika (ini.lihat() == ">") {
          ini.maju()
          jika (ini.cocok("=")) kembalikan ini.buat("GeserKananNolSama", awal, baris, kolom, bb)
          kembalikan ini.buat("GeserKananNol", awal, baris, kolom, bb)
        }
        jika (ini.cocok("=")) kembalikan ini.buat("GeserKananSama", awal, baris, kolom, bb)
        kembalikan ini.buat("GeserKanan", awal, baris, kolom, bb)
      }
      jika (ini.cocok("=")) kembalikan ini.buat("LebihSamaDari", awal, baris, kolom, bb)
      kembalikan ini.buat("LebihDari", awal, baris, kolom, bb)
    }
    jika (karakter == "&") {
      jika (ini.lihat() == "&") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("DanDanSama", awal, baris, kolom, bb)
        kembalikan ini.buat("DanDan", awal, baris, kolom, bb)
      }
      jika (ini.cocok("=")) kembalikan ini.buat("DanSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Dan", awal, baris, kolom, bb)
    }
    jika (karakter == "|") {
      jika (ini.lihat() == "|") {
        ini.maju()
        jika (ini.cocok("=")) kembalikan ini.buat("AtauAtauSama", awal, baris, kolom, bb)
        kembalikan ini.buat("AtauAtau", awal, baris, kolom, bb)
      }
      jika (ini.cocok("=")) kembalikan ini.buat("AtauSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Atau", awal, baris, kolom, bb)
    }
    jika (karakter == "^") {
      jika (ini.cocok("=")) kembalikan ini.buat("XorSama", awal, baris, kolom, bb)
      kembalikan ini.buat("Xor", awal, baris, kolom, bb)
    }

    ini.galat("Karakter tidak dikenal: \"" + karakter + "\"", awal, 1)
  }
}

ekspor fungsi tokenisasi(sumber, namaBerkas) {
  tetap lx = baru Lexer(sumber, namaBerkas)
  kembalikan lx.tokenisasi()
}
